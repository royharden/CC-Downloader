{
  "manifest_version": 3,
  "name": "MSN & YouTube Video Transcript Extractor",
  "version": "1.1.0",
  "description": "Extract transcripts and closed captions from MSN and YouTube video pages.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://*.msn.com/*",
    "https://*.supabase.co/*",
    "https://*.youtube.com/*",
    "https://*.youtu.be/*",
    "https://*.akamaized.net/*",
    "https://*.googlevideo.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.msn.com/*", "https://*.youtube.com/*", "https://youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
